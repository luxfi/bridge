# VCS and CI
.git
.github
.gitignore

# IDE
.vscode
.idea

# Build artifacts
node_modules
**/node_modules
.next
**/.next
**/dist
**/build
**/.turbo

# Documentation
*.md
\!README.md
docs

# Environment files
.env*

# Test files
test
.storybook

# Docker and infrastructure (avoid recursive context)
docker
k8s

# Compose and config files (not needed in build)
compose*.yml
config.yaml
config.kms.yaml
scripts
# Allow the one script that root package.json's postinstall hook needs.
# patch-hanzogui-exports.cjs is a workaround for the broken @hanzo/gui@7.0.0
# upstream publish — pnpm install fails inside the container without it. See
# the script's header for the full explanation + the "remove this file"
# condition.
!scripts/patch-hanzogui-exports.cjs
check-ci-status.sh
push-and-release.sh
