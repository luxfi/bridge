-	// Store in Consul
-	if err := n.storeKeyShareInConsul(req.SessionID, result); err != nil {
-		logger.Errorf("Failed to store key share in Consul: %v", err)
-	}
-
-	// Publish success
-	n.publishKeyGenResult(req.SessionID, true, result.PublicKey)
-}
