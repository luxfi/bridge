{
  "name": "bridge",
  "version": "1.1.1",
  "description": "Lux Bridge - Decentralized cross-chain bridge using MPC",
  "packageManager": "pnpm@9.15.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "install:all": "pnpm install",
    "postinstall": "node scripts/patch-hanzogui-exports.cjs",
    "test": "echo 'Run tests in individual packages'",
    "ci:test": "pnpm -r test"
  },
  "keywords": [
    "bridge",
    "mpc",
    "cross-chain",
    "lux"
  ],
  "author": "Lux Network",
  "license": "BSD-3-Clause",
  "dependencies": {
    "@noble/ed25519": "^3.1.0"
  },
  "workspaces": [
    "app/*",
    "pkg/*",
    "contracts"
  ],
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@hanzo/auth",
        "@hanzo/commerce",
        "firebase",
        "firebase-admin"
      ]
    },
    "overrides": {
      "keccak": "3.0.4",
      "lucide-react": "1.16.0"
    }
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
