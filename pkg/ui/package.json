{
  "name": "@luxbridge/ui-automation",
  "version": "1.0.0",
  "private": true,
  "description": "UI automation tests for Lux Bridge",
  "scripts": {
    "test": "jest",
    "test:smoke": "jest --testPathPattern=smoke",
    "test:mpc": "jest --testPathPattern=mpc",
    "test:networks": "jest --testPathPattern=networks",
    "test:tokens": "jest --testPathPattern=tokens",
    "test:watch": "jest --watch",
    "setup:wallets": "ts-node scripts/setup-wallets.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "devDependencies": {
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/selenium-webdriver": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "selenium-webdriver": "catalog:",
    "ts-jest": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "ethers": "catalog:",
    "viem": "catalog:"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 120000,
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
