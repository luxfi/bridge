{
  "name": "@luxbridge/ui-automation",
  "version": "1.0.0",
  "private": true,
  "description": "UI automation tests for Lux Bridge",
  "scripts": {
    "test": "jest",
    "test:smoke": "jest --testPathPattern=smoke",
    "test:mpc": "jest --testPathPattern=mpc",
    "test:networks": "jest --testPathPattern=networks",
    "test:tokens": "jest --testPathPattern=tokens",
    "test:watch": "jest --watch",
    "setup:wallets": "ts-node scripts/setup-wallets.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/selenium-webdriver": "^4.35.5",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "selenium-webdriver": "^4.44.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "ethers": "^6.16.0",
    "viem": "^2.50.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 120000,
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}