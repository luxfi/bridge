{
  "name": "@luxfi/bridge",
  "version": "1.0.8",
  "description": "Lux Bridge SDK \u2014 embed bridge.lux.network into any host application",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "scope": "@luxfi",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./Bridge": {
        "types": "./dist/Bridge.d.ts",
        "import": "./dist/Bridge.js",
        "default": "./dist/Bridge.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "import": "./dist/config.js",
        "default": "./dist/config.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "import": "./dist/types.js",
        "default": "./dist/types.js"
      },
      "./styles.css": "./dist/app/styles/theme.css",
      "./package.json": "./package.json"
    }
  },
  "author": "Lux Industries, Inc.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxfi/bridge.git",
    "directory": "pkg/bridge"
  },
  "keywords": [
    "lux",
    "luxfi",
    "bridge",
    "mpc",
    "cross-chain",
    "sdk",
    "react"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./Bridge": "./src/Bridge.tsx",
    "./config": "./src/config.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && cp -r src/app/styles dist/app/styles",
    "tc": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lat": "npm show @luxfi/bridge version",
    "prepublishOnly": "node ../../scripts/assert-pnpm-publish.mjs && pnpm run build",
    "pub": "npm publish"
  },
  "dependencies": {
    "@hanzo/gui": "catalog:",
