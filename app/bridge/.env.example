# bridge.lux.network tenant — local dev env
#
# Copy to .env (NOT committed) and fill in any value you want to override.
# All vars are optional; bridge.config.ts has sensible fallbacks for each.
#
# Resolution order at runtime:
#   1. window.__ENV  — populated by /public/__ENV.js (dev) or the docker
#                      entrypoint at container boot (prod). Operator-facing.
#   2. VITE_*        — read from this .env at build time. Dev-only.
#   3. Hard-coded fallback in src/bridge.config.ts.
#
# Production deploys set these via the container env, NOT this file. See
# app/bridge/DEPLOY.md for the full operator runbook.

# ─── Backend ────────────────────────────────────────────────────────────────

# Bridge REST API. The default fallback (`https://bridge-api.lux.network`)
# is the production endpoint — Vite proxies /api/* to it in dev (see
# vite.config.ts) to bypass the CORS allow-list which only whitelists
# https://bridge.lux.network.
# VITE_BRIDGE_API_HOST=https://bridge-api.lux.network

# Environment slug. Drives the chain-registry filter
# (is_testnet === env === 'testnet'). Values: mainnet | testnet | devnet.
# VITE_BRIDGE_ENV=mainnet

# Lux ID OIDC org slug. Defaults to 'lux'.
# VITE_BRIDGE_IAM_ORG=lux

# Lux ID OIDC client id. Per-tenant, registered in IAM.
# VITE_BRIDGE_CLIENT_ID=

# ─── Brand ──────────────────────────────────────────────────────────────────

# Override the bundled @luxfi/logo data-URL. Useful for white-label preview
# builds. Empty → falls back to @luxfi/logo's getColorSVG().
# VITE_BRIDGE_LOGO_URL=

# ─── Wallet ─────────────────────────────────────────────────────────────────

# WalletConnect v2 project id. Free at https://cloud.reown.com — without it,
# the wallet picker omits WalletConnect entirely (only injected/Coinbase
# Wallet SDK appear). Without WC, mobile users CANNOT connect (browser
# extensions don't exist on phone browsers).
# VITE_WC_PROJECT_ID=

# EVM chain id the wallet defaults to on connect. Default 1 (Ethereum).
# VITE_BRIDGE_WALLET_DEFAULT_CHAIN=1

# Comma-separated EVM allow-list. Default 1,42161,8453,137,10
# (Ethereum, Arbitrum, Base, Polygon, Optimism).
# VITE_BRIDGE_WALLET_SUPPORTED_CHAINS=1,42161,8453,137,10

# ─── MPC (signing) ──────────────────────────────────────────────────────────

# M-Chain (ThresholdVM) public endpoint. Drives the MPC session display in
# useTransfers (sessionId / status / signature). Default
# `https://mpc.lux.network` — empty disables client-side MPC progress
# tracking but the backend pipeline still completes signing.
# VITE_BRIDGE_MPC_PUBLIC_URL=https://mpc.lux.network

# Private MPC cluster (treasury fees). Usually unset in tenant deployments.
# VITE_BRIDGE_MPC_PRIVATE_URL=

# Threshold protocol. One of: cggmp21 | frost | bls | doerner | pulsar |
# corona | magnetar. Default cggmp21 (classical ECDSA-CMP, EVM-native).
# VITE_BRIDGE_MPC_PROTOCOL=cggmp21
